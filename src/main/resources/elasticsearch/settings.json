{
  "analysis": {
    "filter": {
      "synonym_filter": {
        "type": "synonym",
        "synonyms": [
          "롤, 리그오브레전드, LOL",
          "아기, 유아",
          "학생, 제자",
          "구입, 구매",
          "예쁜, 아름다운",
          "슬픈, 우울한",
          "기질, 특성",
          "LA, 로스엔젤레스"
        ],
        "expand": false
      }
    },
    "analyzer": {
      "korean_analyzer": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": [
          "lowercase",
          "icu_normalizer"
        ]
      },
      "korean_synonym_analyzer": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": [
          "lowercase",
          "icu_normalizer",
          "synonym_filter"
        ]
      },
      "jaso_analyzer": {
        "type": "custom",
        "tokenizer": "jaso_tokenizer"
      }
    }
  }
}
